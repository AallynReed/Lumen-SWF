{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen-SWF",
  "mainBinaryName": "Lumen-SWF",
  "version": "0.7.0",
  "identifier": "net.aallyn.rustffdec",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "node tools/copy-ruffle.mjs",
    "beforeBuildCommand": "node tools/copy-ruffle.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumen-SWF",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../licenses/Apache-2.0.txt": "licenses/Apache-2.0.txt"
    },
    "fileAssociations": [
      {
        "ext": ["swf"],
        "name": "SWF",
        "description": "Flash movie",
        "role": "Viewer"
      }
    ],
    "copyright": "Aallyn Reed 2026-Present. Based on Free Flash Decompiler.",
    "shortDescription": "Flash SWF decompiler",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": {
        "upgradeCode": "e3bbe3bc-a58a-4e1c-89e7-cb3c4f820119"
      }
    }
  }
}
